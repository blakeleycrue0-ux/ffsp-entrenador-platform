{
  "name": "playoff360",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Playoff360 — Sistema de trabajo para el cuerpo técnico de cualquier club",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.functions.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "maqueta": "node pruebas/solapes.mjs",
    "maqueta:completo": "node pruebas/solapes.mjs --completo",
    "maqueta:contenido": "node pruebas/contenido.mjs",
    "maqueta:perfil": "node pruebas/perfil.mjs",
    "maqueta:fragmentos": "node pruebas/fragmentos.mjs",
    "maqueta:escudo": "node pruebas/escudo.mjs",
    "maqueta:portada": "node pruebas/portada.mjs",
    "maqueta:maquetas": "node pruebas/maquetas.mjs",
    "maqueta:precios": "node pruebas/precios.mjs",
    "app:menu": "node pruebas/menu.mjs",
    "app:pasos": "node pruebas/primeros-pasos.mjs",
    "capturas": "node pruebas/capturas.mjs",
    "maqueta:enteras": "node pruebas/capturas-enteras.mjs",
    "pizarra:colocar": "node pruebas/colocar.mjs",
    "pizarra": "node pruebas/camara.mjs && node pruebas/pizarra.mjs",
    "pizarra:camara": "node pruebas/camara.mjs",
    "pizarra:video": "node pruebas/video.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.49.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
