{
  "name": "playoff360",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Playoff360 — Sistema de trabajo para el cuerpo técnico de cualquier club",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.functions.json && vite build",
