    "maqueta:formularios": "node pruebas/formularios.mjs",
    "maqueta:perfil": "node pruebas/perfil.mjs",
    "maqueta:fragmentos": "node pruebas/fragmentos.mjs",
    "maqueta:escudo": "node pruebas/escudo.mjs",
    "maqueta:portada": "node pruebas/portada.mjs",
    "maqueta:maquetas": "node pruebas/maquetas.mjs",
    "maqueta:precios": "node pruebas/precios.mjs",
    "maqueta:cookies": "node pruebas/cookies.mjs",
    "app:menu": "node pruebas/menu.mjs",
    "app:pasos": "node pruebas/primeros-pasos.mjs",
    "app:crear": "node pruebas/crear.mjs",
    "app:lista": "node pruebas/lista.mjs",
    "app:partido": "node pruebas/partido.mjs",
    "app:complejidad": "node pruebas/complejidad.mjs",
    "app:sin-azul": "node pruebas/sin-azul.mjs",
    "app:alta": "node pruebas/alta.mjs",
    "app:planes": "node pruebas/planes-iguales.mjs",
    "pizarra:circuito": "node pruebas/circuito.mjs",
    "pizarra:salidas": "node pruebas/salidas.mjs",
    "pizarra:encuadre": "node pruebas/encuadre.mjs",
    "pizarra:estorbo": "node pruebas/estorbo.mjs",
    "pizarra:libre": "node pruebas/pizarra-libre.mjs",
